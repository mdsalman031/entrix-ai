# Entrix AI Configuration
# Copy to .env and fill in values

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./entrix.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/entrix

# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=true

# Security
# Generate a unique value; never commit the resulting .env file.
SECRET_KEY=replace-with-a-unique-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# hash runs entirely offline for the deterministic demo; sentence_transformer
# requires a locally available model or a permitted model download.
EMBEDDING_BACKEND=hash

# LLM Provider (mock | openai | anthropic)
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Retrieval
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Sufficiency controller
SUFFICIENCY_ESTIMATOR=heuristic
SUFFICIENCY_THRESHOLD=0.6
MAX_RETRY_ATTEMPTS=1

# Keep true only for local first-run convenience. Use Alembic otherwise.
AUTO_CREATE_SCHEMA=true

# Logging
LOG_LEVEL=INFO
